{
  "version": 1,
  "alias": "nexus",
  "default_node": "victus",
  "council_mode": "web-hybrid",
  "risk_policy": "auto_worktree_only",
  "verification": [
    "python -m pytest -q",
    "python -m compileall -q nexus_v3 ops agent-council"
  ],
  "approval_required": [
    "merge",
    "push",
    "deploy",
    "main_branch_mutation",
    "credential_change"
  ]
}
